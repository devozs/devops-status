# ===========================================
# DevOps Status — Development Environment
# ===========================================
# Loaded by make: include .env.dev then optional .env.dev.local (tunnel public URL).

# ---- Backend (Go) ----
PORT=8080
DATABASE_URL=postgres://devops:devops_local@localhost:5432/devops_status?sslmode=disable
SESSION_KEY=devops-status-dev-session-key-change-in-prod
# Optional. If unset in development, derived from SESSION_KEY. Production must set 64 hex chars (32-byte AES key).
# SECRET_ENCRYPTION_KEY=
ENVIRONMENT=development
# Legacy default image when telemetry omits runner (maps to Alpine preset)
CLI_RUNNER_IMAGE=alpine:3.20
# Per-preset images (telemetry config_json.runner: toolkit | alpine | ubuntu_24)
CLI_RUNNER_IMAGE_ALPINE=alpine:3.20
CLI_RUNNER_IMAGE_UBUNTU_24=ubuntu:24.04
# Build: docker build -f devops-status/devops-status-images/Dockerfile -t devops-status-telemetry-toolkit:local devops-status
CLI_RUNNER_IMAGE_TOOLKIT=devops-status-telemetry-toolkit:local
# Backend CLI: docker (default) or k8s (Job on designated cluster — no Docker socket on API)
CLI_BACKEND_EXECUTOR=docker
CLI_DOCKER_NETWORK=bridge
# When CLI_BACKEND_EXECUTOR=k8s, set to a registered cluster UUID with API token
# CLI_BACKEND_K8S_CLUSTER_ID=
# Max bytes per stdout/stderr stream stored in probe metadata
CLI_LOG_MAX_BYTES=32768
# Browser + CORS origin (local Nuxt dev server)
FRONTEND_URL=http://localhost:3000
# URL the Kubernetes onboarding Job uses to POST /register. In dev, run: make tunnel-up && make tunnel-url
# That writes EXTERNAL_URL=https://*.trycloudflare.com into .env.dev.local (override). Fallback:
EXTERNAL_URL=http://localhost:8080

# Kubernetes API TLS: set true when the control plane uses a private / unknown CA (common on managed clouds).
# Used for admin "Verify API", probe test, and kubernetes probes unless config_json sets insecure_skip_tls.
K8S_INSECURE_SKIP_TLS_VERIFY=true

# ---- Frontend (Nuxt) ----
NUXT_PUBLIC_API_BASE=http://localhost:8080

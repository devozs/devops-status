# ===========================================
# DevOps Status — Development Environment
# ===========================================
# Loaded by make: include .env.dev then optional .env.dev.local (tunnel public URL).

# ---- Backend (Go) ----
PORT=8080
DATABASE_URL=postgres://devops:devops_local@localhost:5432/devops_status?sslmode=disable
SESSION_KEY=devops-status-dev-session-key-change-in-prod
ENVIRONMENT=development
# Browser + CORS origin (local Nuxt dev server)
FRONTEND_URL=http://localhost:3000
# URL the Kubernetes onboarding Job uses to POST /register. In dev, run: make tunnel-up && make tunnel-url
# That writes EXTERNAL_URL=https://*.trycloudflare.com into .env.dev.local (override). Fallback:
EXTERNAL_URL=http://localhost:8080

# Kubernetes API TLS: set true when the control plane uses a private / unknown CA (common on managed clouds).
# Used for admin "Verify API", probe test, and kubernetes probes unless config_json sets insecure_skip_tls.
K8S_INSECURE_SKIP_TLS_VERIFY=true

# ---- Frontend (Nuxt) ----
NUXT_PUBLIC_API_BASE=http://localhost:8080
